{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat App",
  "version": "0.1.0",
  "identifier": "com.chatapp.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chat App",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "minWidth": 980,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
